# GigVault Frontend Environment Configuration

# Set to "true" to use local simulated Mock FIP & in-memory backend
# Set to "false" to connect to a running backend server
NEXT_PUBLIC_USE_MOCKS=true

# Backend API Base URL (used when NEXT_PUBLIC_USE_MOCKS=false)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Polygon Amoy RPC URL (public testnet endpoint)
NEXT_PUBLIC_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Public Contract Addresses (Amoy Testnet)
NEXT_PUBLIC_GIG_PASSPORT_CONTRACT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_WELFARE_VAULT_CONTRACT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MICROCREDIT_CONTRACT=0x0000000000000000000000000000000000000000
