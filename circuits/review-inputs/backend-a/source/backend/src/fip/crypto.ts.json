{
  "lines": [
    "/**",
    " * GigVault - Mock FIP Cryptography & Signing",
    " * ",
    " * Implements Mock FIP key management, canonical payload serialization,",
    " * SHA-256 hashing, and secp256k1 ECDSA signing and verification.",
    " * ",
    " * Note: Clearly labeled as a mock FIP signing protocol, simulating bank",
    " * provenance without claiming official RBI AA/FIP protocol compliance.",
    " */",
    "",
    "import crypto from 'node:crypto';",
    "import type { SignedFIPPayload } from './types.js';",
    "",
    "export interface KeyPair {",
    "  privateKeyPem: string;",
    "  publicKeyPem: string;",
    "}",
    "",
    "/**",
    " * Generate a new secp256k1 ECDSA key pair for the Mock FIP.",
    " */",
    "export function generateFipKeyPair(): KeyPair {",
    "  const { privateKey, publicKey } = crypto.generateKeyPairSync('ec', {",
    "    namedCurve: 'secp256k1',",
    "    publicKeyEncoding: { type: 'spki', format: 'pem' },",
    "    privateKeyEncoding: { type: 'pkcs8', format: 'pem' },",
    "  });",
    "  return {",
    "    privateKeyPem: privateKey,",
    "    publicKeyPem: publicKey,",
    "  };",
    "}",
    "",
    "/**",
    " * Recursively sort object keys for deterministic canonical JSON stringification.",
    " */",
    "export function canonicalStringify(obj: unknown): string {",
    "  if (obj === null || typeof obj !== 'object') {",
    "    return JSON.stringify(obj);",
    "  }",
    "  if (Array.isArray(obj)) {",
    "    return '[' + obj.map((item) => canonicalStringify(item)).join(',') + ']';",
    "  }",
    "  const keys = Object.keys(obj as Record<string, unknown>).sort();",
    "  const entries = keys.map((key) => {",
    "    const val = (obj as Record<string, unknown>)[key];",
    "    return `${JSON.stringify(key)}:${canonicalStringify(val)}`;",
    "  });",
    "  return '{' + entries.join(',') + '}';",
    "}",
    "",
    "/**",
    " * Compute SHA-256 hash of canonical payload representation.",
    " */",
    "export function hashPayload(payload: SignedFIPPayload): string {",
    "  const canonical = canonicalStringify(payload);",
    "  return crypto.createHash('sha256').update(canonical, 'utf8').digest('hex');",
    "}",
    "",
    "/**",
    " * Sign payload hash using Mock FIP secp256k1 private key.",
    " */",
    "export function signPayloadHash(payloadHash: string, privateKeyPem: string): string {",
    "  const signer = crypto.createSign('SHA256');",
    "  signer.update(payloadHash, 'utf8');",
    "  signer.end();",
    "  return signer.sign(privateKeyPem, 'hex');",
    "}",
    "",
    "/**",
    " * Verify secp256k1 signature over payload hash against public key.",
    " */",
    "export function verifySignature(",
    "  payloadHash: string,",
    "  signatureHex: string,",
    "  publicKeyPem: string",
    "): boolean {",
    "  try {",
    "    const verifier = crypto.createVerify('SHA256');",
    "    verifier.update(payloadHash, 'utf8');",
    "    verifier.end();",
    "    return verifier.verify(publicKeyPem, signatureHex, 'hex');",
    "  } catch {",
    "    return false;",
    "  }",
    "}",
    ""
  ]
}
